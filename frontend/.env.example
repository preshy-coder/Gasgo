# Copy this file to `.env` and fill in the values. Never commit `.env`.

# true = use the built-in fake backend (no Django server needed)
# false = talk to the real Django API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true

# Base URL of the Django REST API (must end with /api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Google Maps browser key (restrict it to your website domains in Google Cloud).
# Leave empty to use the simple built-in location picker instead of the map.
VITE_GOOGLE_MAPS_API_KEY=
